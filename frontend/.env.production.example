# Frontend environment files

# .env.development (local dev — proxied by Vite)
VITE_API_URL=

# .env.production (live deployment — set this to your Code Engine backend URL)
# Replace with your actual IBM Code Engine backend URL after Part 5
VITE_API_URL=https://primeledger-backend.REPLACE_WITH_YOUR_URL.us-south.codeengine.appdomain.cloud
